---
import NameMark from './NameMark.astro';
import EmailLink from './EmailLink.astro';
import { site } from '../site.config';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__mark"><NameMark size="footer" /> <span class="footer__year">· {year}</span></p>
    <ul class="footer__links">
      {site.email && <li><EmailLink variant="text" /></li>}
      <li><a href={site.linkedin} rel="me noopener">LinkedIn</a></li>
      <li><a href={site.github} rel="me noopener">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: var(--rule);
    margin-top: var(--space-9);
    padding: var(--space-6) 0;
    background: var(--paper);
  }
  .footer__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
  }
  .footer__mark {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .footer__year {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--kale-soft);
  }
  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: var(--space-5);
  }
  .footer__links a {
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
